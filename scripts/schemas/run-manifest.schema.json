{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deltafuse.invalid/schemas/run-manifest.schema.json",
  "title": "DeltaFuse v3 qualification campaign manifest",
  "description": "Campaign manifest (QF-008; strict per QF-017): every entry carries provenance, no format drift.",
  "type": "object",
  "required": [
    "schema_version", "campaign_id", "created", "framework", "executor", "model",
    "thresholds", "cases", "runs", "case_verdicts", "verdict"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "created": { "type": "string", "minLength": 1 },
    "framework": {
      "type": "object",
      "required": ["commit", "lock_hash"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "lock_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "executor": {
      "type": "object",
      "description": "QF-013: attestation of the execution boundary that ran the Worker.",
      "required": ["kind", "boundary", "network_policy"],
      "properties": {
        "kind": { "$ref": "#/$defs/attested" },
        "boundary": { "$ref": "#/$defs/attested" },
        "network_policy": { "$ref": "#/$defs/attested" },
        "runtime": { "$ref": "#/$defs/attested" },
        "image": { "$ref": "#/$defs/attested" },
        "image_digest": { "$ref": "#/$defs/attested" },
        "wheel_sha256": { "$ref": "#/$defs/attested" },
        "mounts": { "$ref": "#/$defs/attested" },
        "release_cap": { "$ref": "#/$defs/attested" },
        "boundary_probe": { "$ref": "#/$defs/attested" }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "description": "QF-007 attested host model block: provenance-tagged fields.",
      "additionalProperties": { "$ref": "#/$defs/attested" }
    },
    "thresholds": {
      "type": "object",
      "required": ["source", "revision", "absolute"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "absolute": {
          "type": "object",
          "required": [
            "correctness_failed", "stages_completed", "gate_retries_max",
            "context_peak_tokens_max", "framework_input_tokens_max",
            "max_unique_files", "hallucinated_paths", "envelope_violations",
            "evidence_authentic"
          ],
          "properties": {
            "correctness_failed": { "const": 0 },
            "stages_completed": { "const": 7 },
            "gate_retries_max": { "type": "integer", "minimum": 0 },
            "context_peak_tokens_max": { "type": "integer", "minimum": 1 },
            "framework_input_tokens_max": { "type": "integer", "minimum": 1 },
            "max_unique_files": { "type": "integer", "minimum": 1 },
            "hallucinated_paths": { "const": 0 },
            "envelope_violations": { "const": 0 },
            "evidence_authentic": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "case", "verdict", "threshold_failures"],
        "properties": {
          "run_id": { "type": "string", "minLength": 1 },
          "case": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["pass", "fail"] },
          "threshold_failures": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "error": {
            "type": "object",
            "required": ["class", "detail"],
            "properties": {
              "class": { "enum": ["host_error", "score_error", "io_error", "schema_error", "internal_error"] },
              "detail": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "case_verdicts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["verdict", "medians", "median_failures"],
        "properties": {
          "verdict": { "enum": ["pass", "fail"] },
          "medians": {
            "type": "object",
            "required": [
              "correctness", "process", "context_peak_tokens",
              "framework_input_tokens_max", "framework_input_chars_max",
              "gate_retries", "max_unique_files", "hallucinated_paths",
              "envelope_violations"
            ],
            "properties": {
              "correctness": { "type": ["number", "null"] },
              "process": { "type": ["number", "null"] },
              "context_peak_tokens": { "type": ["number", "null"] },
              "framework_input_tokens_max": { "type": ["number", "null"] },
              "framework_input_chars_max": { "type": ["number", "null"] },
              "gate_retries": { "type": ["number", "null"] },
              "max_unique_files": { "type": ["number", "null"] },
              "hallucinated_paths": { "type": ["number", "null"] },
              "envelope_violations": { "type": ["number", "null"] }
            },
            "additionalProperties": false
          },
          "median_failures": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "verdict": { "enum": ["pass", "fail", "incomplete", "pending", "non-release"] },
    "tokenizer_fingerprint_match": { "$ref": "#/$defs/attested" }
  },
  "additionalProperties": false,
  "$defs": {
    "attested": {
      "type": "object",
      "description": "QF-007: provenance-tagged manifest field.",
      "required": ["value", "provenance"],
      "properties": {
        "value": {},
        "provenance": { "enum": ["measured", "declared", "derived"] },
        "method": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": ["string", "null"] },
        "calibration_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
