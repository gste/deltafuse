{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deltafuse.invalid/schemas/qual-image.schema.json",
  "title": "DeltaFuse qualification command image build manifest (QF-019)",
  "type": "object",
  "required": [
    "schema_version", "commit", "tree_clean", "image_tag", "image_id",
    "wheel", "wheel_sha256", "wheel_size_bytes", "base_image", "pytest_pin",
    "containerfile", "python", "platform", "created", "commands"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tree_clean": { "const": true },
    "image_tag": { "type": "string", "minLength": 1 },
    "image_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "wheel": { "type": "string" },
    "wheel_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "wheel_size_bytes": { "type": "integer", "minimum": 1 },
    "base_image": { "type": "string", "minLength": 1 },
    "pytest_pin": { "type": "string", "minLength": 1 },
    "containerfile": { "type": "string", "minLength": 1 },
    "python": { "type": "string" },
    "platform": { "type": "string" },
    "created": { "type": "string", "format": "date-time" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "rc"],
        "properties": {
          "command": { "type": "string" },
          "rc": { "type": "integer" }
        }
      }
    }
  },
  "additionalProperties": false
}
