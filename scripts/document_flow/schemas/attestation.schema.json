{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deltafuse:j03:attestation:1",
  "title": "J03 runtime attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attestation_hash", "profile_id", "status", "release_eligible", "evidence_root_id", "framework", "executor", "agent", "model", "host", "config_policy"],
  "properties": {
    "schema_version": {"const": 1}, "attestation_hash": {"$ref": "#/$defs/hash"}, "profile_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["measured", "declared"]}, "release_eligible": {"type": "boolean"}, "evidence_root_id": {"$ref": "#/$defs/id"},
    "framework": {"$ref": "#/$defs/framework"}, "executor": {"$ref": "#/$defs/executor"}, "agent": {"$ref": "#/$defs/agent"},
    "model": {"$ref": "#/$defs/model"}, "host": {"$ref": "#/$defs/host"}, "config_policy": {"$ref": "#/$defs/config_policy"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "measured"}}, "required": ["status"]},
      "then": {"properties": {
        "release_eligible": {"const": true},
        "model": {"properties": {
          "measurement_source": {"const": "measured"}, "context_window_tokens": {"type": "integer", "minimum": 1},
          "max_output_tokens": {"type": "integer", "minimum": 1}
        }}
      }}
    },
    {
      "if": {"properties": {"status": {"const": "declared"}}, "required": ["status"]},
      "then": {"properties": {"release_eligible": {"const": false}, "model": {"properties": {"measurement_source": {"const": "declared"}}}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "string", "minLength": 1}, "evidence_ref": {"$ref": "urn:deltafuse:j03:evidence-ref:1"},
    "framework": {
      "type": "object", "additionalProperties": false, "required": ["commit", "version", "wheel_sha256", "lock_sha256", "evidence_ref"],
      "properties": {"commit": {"$ref": "#/$defs/commit"}, "version": {"const": "3.0.0"}, "wheel_sha256": {"$ref": "#/$defs/hash"}, "lock_sha256": {"$ref": "#/$defs/hash"}, "evidence_ref": {"$ref": "#/$defs/evidence_ref"}}
    },
    "executor": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "inspect_sha256", "dependency_sha256", "evidence_ref"],
      "properties": {"name": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"}, "inspect_sha256": {"$ref": "#/$defs/hash"}, "dependency_sha256": {"$ref": "#/$defs/hash"}, "evidence_ref": {"$ref": "#/$defs/evidence_ref"}}
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "package_sha256", "launcher_sha256", "dependency_lock_sha256", "redacted_config_sha256", "extension_manifest_sha256", "extension_sha256s", "secret_fields_redacted", "evidence_ref"],
      "properties": {
        "name": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"}, "package_sha256": {"$ref": "#/$defs/hash"},
        "launcher_sha256": {"$ref": "#/$defs/hash"}, "dependency_lock_sha256": {"$ref": "#/$defs/hash"},
        "redacted_config_sha256": {"$ref": "#/$defs/hash"}, "extension_manifest_sha256": {"$ref": "#/$defs/hash"},
        "extension_sha256s": {"type": "array", "items": {"$ref": "#/$defs/hash"}, "uniqueItems": true},
        "secret_fields_redacted": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence_ref": {"$ref": "#/$defs/evidence_ref"}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "provider_id", "weights_sha256", "quantization", "tokenizer_sha256", "endpoint_attestation_sha256", "context_window_tokens", "max_output_tokens", "measurement_source", "evidence_ref"],
      "properties": {
        "model_id": {"$ref": "#/$defs/id"}, "provider_id": {"$ref": "#/$defs/id"}, "weights_sha256": {"$ref": "#/$defs/hash"},
        "quantization": {"$ref": "#/$defs/id"}, "tokenizer_sha256": {"$ref": "#/$defs/hash"}, "endpoint_attestation_sha256": {"$ref": "#/$defs/hash"},
        "context_window_tokens": {"type": ["integer", "null"], "minimum": 1}, "max_output_tokens": {"type": ["integer", "null"], "minimum": 1},
        "measurement_source": {"enum": ["measured", "declared"]}, "evidence_ref": {"$ref": "#/$defs/evidence_ref"}
      }
    },
    "image": {
      "type": "object", "additionalProperties": false, "required": ["name", "reference", "digest", "platform", "inspect_ref"],
      "properties": {
        "name": {"$ref": "#/$defs/id"}, "reference": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "platform": {"pattern": "^[a-z0-9_-]+/[a-z0-9_.-]+$"},
        "inspect_ref": {"$ref": "#/$defs/evidence_ref"}
      }
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["host_profile_sha256", "runtime_inventory_sha256", "dependency_inventory_sha256", "resource_limits_sha256", "network_policy_sha256", "images", "evidence_ref"],
      "properties": {
        "host_profile_sha256": {"$ref": "#/$defs/hash"}, "runtime_inventory_sha256": {"$ref": "#/$defs/hash"},
        "dependency_inventory_sha256": {"$ref": "#/$defs/hash"}, "resource_limits_sha256": {"$ref": "#/$defs/hash"},
        "network_policy_sha256": {"$ref": "#/$defs/hash"}, "images": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/image"}, "uniqueItems": true},
        "evidence_ref": {"$ref": "#/$defs/evidence_ref"}
      }
    },
    "config_policy": {
      "type": "object", "additionalProperties": false, "required": ["contains_secret_values", "redaction_manifest_sha256", "evidence_ref"],
      "properties": {"contains_secret_values": {"const": false}, "redaction_manifest_sha256": {"$ref": "#/$defs/hash"}, "evidence_ref": {"$ref": "#/$defs/evidence_ref"}}
    }
  }
}
