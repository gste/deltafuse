{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deltafuse:j03:event:1",
  "title": "J03 sealed raw event",
  "allOf": [
    {"$ref": "#/$defs/common"},
    {
      "oneOf": [
        {"properties": {"kind": {"const": "core"}, "payload": {"$ref": "#/$defs/core"}}},
        {"properties": {"kind": {"const": "model_call"}, "call_id": {"type": "string", "minLength": 1}, "payload": {"$ref": "#/$defs/model_call"}}},
        {"properties": {"kind": {"const": "file_access"}, "payload": {"$ref": "#/$defs/file_access"}}},
        {"properties": {"kind": {"const": "command"}, "payload": {"$ref": "#/$defs/command"}}},
        {"properties": {"kind": {"const": "compaction"}, "payload": {"$ref": "#/$defs/compaction"}}},
        {"properties": {"kind": {"const": "boundary"}, "payload": {"$ref": "#/$defs/boundary"}}},
        {"properties": {"kind": {"const": "human_gate"}, "payload": {"$ref": "#/$defs/human_gate"}}}
      ]
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1},
    "nullable_id": {"type": ["string", "null"], "minLength": 1},
    "nullable_count": {"type": ["integer", "null"], "minimum": 0},
    "evidence_ref": {"$ref": "urn:deltafuse:j03:evidence-ref:1"},
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event_id", "sequence", "previous_hash", "event_hash", "monotonic_ns", "diagnostic_timestamp", "run_id", "session_id", "call_id", "visit_id", "task_id", "stage_id", "kind", "host_source", "payload"],
      "properties": {
        "schema_version": {"const": 1},
        "event_id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 0},
        "previous_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "event_hash": {"$ref": "#/$defs/hash"},
        "monotonic_ns": {"type": "integer", "minimum": 0},
        "diagnostic_timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
        "run_id": {"$ref": "#/$defs/id"},
        "session_id": {"$ref": "#/$defs/id"},
        "call_id": {"$ref": "#/$defs/nullable_id"},
        "visit_id": {"$ref": "#/$defs/id"},
        "task_id": {"$ref": "#/$defs/nullable_id"},
        "stage_id": {"enum": ["intake", "analyze", "specify", "decompose", "declare", "implement", "verify", "system"]},
        "kind": {"enum": ["core", "model_call", "file_access", "command", "compaction", "boundary", "human_gate"]},
        "host_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_id", "collector_id"],
          "properties": {"host_id": {"$ref": "#/$defs/id"}, "collector_id": {"$ref": "#/$defs/id"}}
        },
        "payload": {"type": "object"}
      }
    },
    "core": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "next_stage", "halted", "evidence_refs"],
      "properties": {
        "action": {"enum": ["next", "evidence", "check_gate", "archive", "board"]},
        "next_stage": {"type": ["string", "null"]}, "halted": {"type": "boolean"},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true}
      }
    },
    "model_call": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "framework_tokens", "reserved_output_tokens", "tokenizer_fingerprint", "template_fingerprint", "usage_source", "request_sha256", "response_sha256", "thinking_retained", "profile_id"],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/nullable_count"}, "output_tokens": {"$ref": "#/$defs/nullable_count"},
        "framework_tokens": {"$ref": "#/$defs/nullable_count"}, "reserved_output_tokens": {"$ref": "#/$defs/nullable_count"},
        "tokenizer_fingerprint": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "template_fingerprint": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "usage_source": {"enum": ["provider", "tokenizer", "unmeasured"]},
        "request_sha256": {"$ref": "#/$defs/hash"}, "response_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "thinking_retained": {"type": ["boolean", "null"]}, "profile_id": {"$ref": "#/$defs/id"}
      }
    },
    "file_access": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_path", "file_sha256", "range", "operation", "origin", "repeat_relation", "allowed", "tool_id", "call_id", "process_id"],
      "properties": {
        "canonical_path": {"type": "string", "minLength": 1}, "file_sha256": {"$ref": "#/$defs/hash"},
        "range": {"type": ["object", "null"], "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}}},
        "operation": {"enum": ["read", "write", "list", "stat"]}, "origin": {"enum": ["tool", "command", "worker", "host"]},
        "repeat_relation": {"type": ["string", "null"]}, "allowed": {"type": "boolean"},
        "tool_id": {"$ref": "#/$defs/nullable_id"}, "call_id": {"$ref": "#/$defs/nullable_id"}, "process_id": {"$ref": "#/$defs/nullable_id"}
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "cwd", "environment_inventory_sha256", "started_monotonic_ns", "finished_monotonic_ns", "timed_out", "exit_code", "stdout_ref", "stderr_ref", "process_id", "executor_id", "target_snapshot_id", "operation_instance_id"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "cwd": {"type": "string", "minLength": 1},
        "environment_inventory_sha256": {"$ref": "#/$defs/hash"}, "started_monotonic_ns": {"type": "integer", "minimum": 0},
        "finished_monotonic_ns": {"type": "integer", "minimum": 0}, "timed_out": {"type": "boolean"},
        "exit_code": {"type": ["integer", "null"]}, "stdout_ref": {"anyOf": [{"$ref": "#/$defs/evidence_ref"}, {"type": "null"}]},
        "stderr_ref": {"anyOf": [{"$ref": "#/$defs/evidence_ref"}, {"type": "null"}]}, "process_id": {"$ref": "#/$defs/id"},
        "executor_id": {"$ref": "#/$defs/id"}, "target_snapshot_id": {"$ref": "#/$defs/id"}, "operation_instance_id": {"$ref": "#/$defs/id"}
      }
    },
    "compaction": {
      "type": "object", "additionalProperties": false,
      "required": ["before_session_ref", "after_session_ref", "before_request_ref", "after_request_ref", "cause", "before_tokens", "after_tokens", "retained_state", "lost_state_checks"],
      "properties": {
        "before_session_ref": {"$ref": "#/$defs/id"}, "after_session_ref": {"$ref": "#/$defs/id"},
        "before_request_ref": {"$ref": "#/$defs/id"}, "after_request_ref": {"$ref": "#/$defs/id"}, "cause": {"type": "string", "minLength": 1},
        "before_tokens": {"$ref": "#/$defs/nullable_count"}, "after_tokens": {"$ref": "#/$defs/nullable_count"},
        "retained_state": {"type": "boolean"}, "lost_state_checks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary_type", "phase", "envelope_sha256", "allowed", "reason"],
      "properties": {
        "boundary_type": {"enum": ["file", "command", "network", "model", "sandbox"]}, "phase": {"enum": ["enter", "exit", "deny"]},
        "envelope_sha256": {"$ref": "#/$defs/hash"}, "allowed": {"type": "boolean"}, "reason": {"type": ["string", "null"]}
      }
    },
    "human_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["halted", "gate_type", "chosen_option", "operator_id", "receipt_ref", "resume_state"],
      "properties": {
        "halted": {"const": true}, "gate_type": {"enum": ["decision", "spec", "merge"]}, "chosen_option": {"type": ["string", "null"]},
        "operator_id": {"$ref": "#/$defs/nullable_id"}, "receipt_ref": {"anyOf": [{"$ref": "#/$defs/evidence_ref"}, {"type": "null"}]},
        "resume_state": {"enum": ["awaiting_operator", "resumed"]}
      }
    }
  }
}
