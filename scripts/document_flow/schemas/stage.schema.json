{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deltafuse:j03:stage-report:1",
  "title": "J03 immutable stage report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_hash", "predecessor_report_hash", "identity", "status", "lifecycle", "visit_ids", "task_attempts", "snapshot_refs", "attestation_refs", "event_refs", "checks", "measurements", "totals", "hard_failures", "test_result_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "report_hash": {"$ref": "#/$defs/hash"},
    "predecessor_report_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "identity": {"$ref": "#/$defs/identity"},
    "status": {"enum": ["passed", "failed", "not_reached", "invalid"]},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "visit_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "task_attempts": {"type": "array", "items": {"$ref": "#/$defs/task_attempt"}},
    "snapshot_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true},
    "attestation_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true},
    "event_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "measurements": {"$ref": "#/$defs/measurements"},
    "totals": {"$ref": "#/$defs/totals"},
    "hard_failures": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "test_result_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "visit_ids": {"minItems": 1}, "task_attempts": {"minItems": 1}, "snapshot_refs": {"minItems": 1}, "event_refs": {"minItems": 1},
          "checks": {"minItems": 1}, "test_result_refs": {"minItems": 1}, "hard_failures": {"maxItems": 0},
          "measurements": {
            "properties": {
              "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0},
              "framework_tokens": {"type": "integer", "minimum": 0}, "context_peak_tokens": {"type": "integer", "minimum": 0},
              "provenance_refs": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "not_reached"}}, "required": ["status"]},
      "then": {
        "properties": {
          "visit_ids": {"maxItems": 0}, "task_attempts": {"maxItems": 0}, "snapshot_refs": {"maxItems": 0}, "event_refs": {"maxItems": 0},
          "checks": {"maxItems": 0}, "test_result_refs": {"maxItems": 0},
          "lifecycle": {"properties": {"start_state": {"type": "null"}, "end_state": {"type": "null"}}},
          "totals": {"properties": {"correctness": {"const": 0}, "discipline": {"const": 0}, "efficiency": {"const": 0}, "score": {"const": 0}}},
          "measurements": {"properties": {"worker_calls": {"const": 0}, "provenance_refs": {"maxItems": 0}}}
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1},
    "nullable_count": {"type": ["integer", "null"], "minimum": 0},
    "evidence_ref": {"$ref": "urn:deltafuse:j03:evidence-ref:1"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_id", "run_id", "case_id", "variant_id", "stage_id", "framework_commit", "wheel_sha256", "lock_sha256", "registry_sha256", "agent_name", "agent_version", "agent_config_sha256", "model_id", "provider_id", "endpoint_attestation_ref", "tokenizer_fingerprint"],
      "properties": {
        "campaign_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "variant_id": {"$ref": "#/$defs/id"},
        "stage_id": {"enum": ["intake", "analyze", "specify", "decompose", "declare", "implement", "verify"]},
        "framework_commit": {"$ref": "#/$defs/hash"}, "wheel_sha256": {"$ref": "#/$defs/hash"}, "lock_sha256": {"$ref": "#/$defs/hash"},
        "registry_sha256": {"$ref": "#/$defs/hash"}, "agent_name": {"$ref": "#/$defs/id"}, "agent_version": {"$ref": "#/$defs/id"},
        "agent_config_sha256": {"$ref": "#/$defs/hash"}, "model_id": {"$ref": "#/$defs/id"}, "provider_id": {"$ref": "#/$defs/id"},
        "endpoint_attestation_ref": {"$ref": "#/$defs/evidence_ref"}, "tokenizer_fingerprint": {"$ref": "#/$defs/hash"}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false, "required": ["start_state", "end_state", "next_stage"],
      "properties": {
        "start_state": {"type": ["string", "null"]}, "end_state": {"type": ["string", "null"]},
        "next_stage": {"type": ["string", "null"]}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "status", "awarded_points", "evidence_refs", "failure_reason"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^(?:IN|AN|SP|DE|RD|IM|VE)\\.(?:C0[1-4]|D0[1-5])$"},
        "status": {"enum": ["pass", "fail", "not_reached"]}, "awarded_points": {"type": "integer", "minimum": 0, "maximum": 600},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true},
        "failure_reason": {"type": ["string", "null"]}
      }
    },
    "task_attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "attempt", "visit_ids", "status", "evidence_refs"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"}, "attempt": {"type": "integer", "minimum": 1},
        "visit_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "status": {"enum": ["passed", "failed", "halted"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true}
      }
    },
    "measurements": {
      "type": "object", "additionalProperties": false,
      "required": ["worker_calls", "input_tokens", "output_tokens", "framework_tokens", "files_read", "files_written", "files_reread", "tool_calls", "tool_failures", "timeouts", "rejected_actions", "gate_retries", "evidence_retries", "coverage_retries", "compaction_count", "context_peak_tokens", "wall_time_ms", "provenance_refs"],
      "properties": {
        "worker_calls": {"type": "integer", "minimum": 0}, "input_tokens": {"$ref": "#/$defs/nullable_count"}, "output_tokens": {"$ref": "#/$defs/nullable_count"},
        "framework_tokens": {"$ref": "#/$defs/nullable_count"}, "files_read": {"type": "integer", "minimum": 0}, "files_written": {"type": "integer", "minimum": 0},
        "files_reread": {"type": "integer", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0}, "tool_failures": {"type": "integer", "minimum": 0},
        "timeouts": {"type": "integer", "minimum": 0}, "rejected_actions": {"type": "integer", "minimum": 0}, "gate_retries": {"type": "integer", "minimum": 0},
        "evidence_retries": {"type": "integer", "minimum": 0}, "coverage_retries": {"type": "integer", "minimum": 0}, "compaction_count": {"type": "integer", "minimum": 0},
        "context_peak_tokens": {"$ref": "#/$defs/nullable_count"}, "wall_time_ms": {"$ref": "#/$defs/nullable_count"},
        "provenance_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true}
      }
    },
    "totals": {
      "type": "object", "additionalProperties": false, "required": ["correctness", "discipline", "efficiency", "score"],
      "properties": {
        "correctness": {"type": "integer", "minimum": 0, "maximum": 600}, "discipline": {"type": "integer", "minimum": 0, "maximum": 250},
        "efficiency": {"type": "integer", "minimum": 0, "maximum": 150}, "score": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    }
  }
}
