{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deltafuse:j03:variant:1",
  "title": "J03 generated variant manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_hash", "variant_id", "seed", "generator", "operation_stream", "ambiguity_ids", "workload_ids"],
  "properties": {
    "schema_version": {"const": 1}, "manifest_hash": {"$ref": "#/$defs/hash"}, "variant_id": {"$ref": "#/$defs/id"},
    "seed": {"type": "integer", "minimum": 0}, "generator": {"$ref": "#/$defs/generator"},
    "operation_stream": {"$ref": "#/$defs/operation_stream"},
    "ambiguity_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "workload_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "string", "minLength": 1}, "evidence_ref": {"$ref": "urn:deltafuse:j03:evidence-ref:1"},
    "generator": {
      "type": "object", "additionalProperties": false, "required": ["source_revision", "source_sha256", "contract_sha256"],
      "properties": {"source_revision": {"$ref": "#/$defs/commit"}, "source_sha256": {"$ref": "#/$defs/hash"}, "contract_sha256": {"$ref": "#/$defs/hash"}}
    },
    "operation_stream": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "operation_count", "evidence_ref"],
      "properties": {"sha256": {"$ref": "#/$defs/hash"}, "operation_count": {"type": "integer", "minimum": 1}, "evidence_ref": {"$ref": "#/$defs/evidence_ref"}}
    }
  }
}
